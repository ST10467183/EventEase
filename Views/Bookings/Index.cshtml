@model IEnumerable<EventEase.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<h1>Bookings</h1>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-3">
            <input type="text" name="searchString" class="form-control" placeholder="Booking ID or Event Name..." value="@ViewData["CurrentSearch"]" />
        </div>
        <div class="col-md-2">
            <select name="eventTypeId" class="form-control" asp-items="ViewBag.EventTypeId">
                <option value="">All Types</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="venueId" class="form-control" asp-items="ViewBag.VenueId">
                <option value="">All Venues</option>
            </select>
        </div>
        <div class="col-md-2">
            <input type="date" name="startDate" class="form-control" value="@ViewData["CurrentStartDate"]" />
        </div>
        <div class="col-md-2">
            <input type="date" name="endDate" class="form-control" value="@ViewData["CurrentEndDate"]" />
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-success">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Booking ID</th>
            <th>Booking Date</th>
            <th>Venue</th>
            <th>Event</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.BookingId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.BookingDate)
                </td>
                <td>
                    @item.Venue?.VenueName
                </td>
                <td>
                    @item.Event?.EventName
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.BookingId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.BookingId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.BookingId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>